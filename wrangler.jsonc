{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datastore-api",
  "account_id": "ccda1018431c9d935588b68f06478ba9",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "datastore-items" }
  ],
  "triggers": { "crons": ["15 1 * * *"] },
  "ratelimits": [
    { "name": "PASSWORD_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    "NETWORK": "eip155:84532",
    "PAY_TO": "0x0000000000000000000000000000000000000001",
    "FACILITATOR_URL": "https://x402.org/facilitator",
    "API_ORIGIN": "http://localhost:8787",
    "DL_ORIGIN": "http://localhost:8788",
    "MAX_BYTES": "26214400",
    "MAX_TTL_DAYS": "365",
    "DEFAULT_TTL_DAYS": "7",
    "SERVICE_NAME": "DataStore API"
  }
  ,
  "env": {
    "testnet": {
      "name": "datastore-api-testnet",
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "datastore-items-testnet" }],
      "ratelimits": [
        { "name": "PASSWORD_LIMITER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "2002", "simple": { "limit": 600, "period": 60 } }
      ],
      "vars": {
        "NETWORK": "eip155:84532",
        "PAY_TO": "0x0000000000000000000000000000000000000001",
        "FACILITATOR_URL": "https://x402.org/facilitator",
        "API_ORIGIN": "https://api-testnet.example.com",
        "DL_ORIGIN": "https://share-testnet.example.net",
        "MAX_BYTES": "1048576",
        "MAX_TTL_DAYS": "7",
        "DEFAULT_TTL_DAYS": "1",
        "SERVICE_NAME": "DataStore API (testnet)"
      }
    },
    "testnet-share": {
      "name": "datastore-share-testnet",
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "datastore-items-testnet" }],
      "ratelimits": [
        { "name": "PASSWORD_LIMITER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "2002", "simple": { "limit": 600, "period": 60 } }
      ],
      "triggers": { "crons": [] },
      "vars": {
        "NETWORK": "eip155:84532",
        "PAY_TO": "0x0000000000000000000000000000000000000001",
        "FACILITATOR_URL": "https://x402.org/facilitator",
        "API_ORIGIN": "https://api-testnet.example.com",
        "DL_ORIGIN": "https://share-testnet.example.net",
        "MAX_BYTES": "1048576",
        "MAX_TTL_DAYS": "7",
        "DEFAULT_TTL_DAYS": "1",
        "SERVICE_NAME": "DataStore API (testnet)"
      }
    },
    "production": {
      "name": "datastore-api-prod",
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "datastore-items-prod" }],
      "ratelimits": [
        { "name": "PASSWORD_LIMITER", "namespace_id": "3001", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "3002", "simple": { "limit": 600, "period": 60 } }
      ],
      "vars": {
        "NETWORK": "eip155:8453",
        "PAY_TO": "0x0000000000000000000000000000000000000001",
        "FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "API_ORIGIN": "https://api.example.com",
        "DL_ORIGIN": "https://share.example.net",
        "MAX_BYTES": "26214400",
        "MAX_TTL_DAYS": "365",
        "DEFAULT_TTL_DAYS": "7",
        "SERVICE_NAME": "DataStore API"
      }
    }
  }
}
